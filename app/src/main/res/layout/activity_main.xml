<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Bottom Navigation -->

    <FrameLayout
        android:id="@+id/containerLayout"
        android:background="@color/text_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

    </FrameLayout>

    <FrameLayout
        android:id="@+id/containerChatBot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/bottomContainer"
        android:layout_marginTop="0dp"
        android:background="@android:color/white">

        <!-- Nội dung chat -->

    </FrameLayout>


    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Custom Toolbar: 2/3 -->
        <FrameLayout
            android:id="@+id/customToolbarWrapper"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="2"
            android:layout_marginLeft="18dp">

            <!-- Custom Toolbar -->
            <LinearLayout
                android:id="@+id/customToolbar"
                android:layout_width="match_parent"
                android:translationZ="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bottom_toolbar"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <!-- Home -->
                <LinearLayout
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- History -->
                <LinearLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_history" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Indicator hình tròn -->
            <View
                android:id="@+id/indicator"
                android:layout_width="0dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_active_toolbar"/>
        </FrameLayout>



        <!-- ChatBot Button: 1/3 -->
        <LinearLayout
            android:id="@+id/buttonChatBot"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- this is button -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:elevation="1dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ChatBot"
                    android:textColor="@color/black"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>


</RelativeLayout>
