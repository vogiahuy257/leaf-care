<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Bottom Navigation -->

    <FrameLayout
        android:id="@+id/containerLayout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

    </FrameLayout>



    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <!-- Custom Toolbar: 2/3 -->
        <FrameLayout
            android:id="@+id/customToolbarWrapper"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="2"
            android:layout_marginLeft="18dp">

            <!-- Custom Toolbar -->
            <LinearLayout
                android:id="@+id/customToolbar"
                android:layout_width="match_parent"
                android:translationZ="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bottom_toolbar"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <!-- Home -->
                <LinearLayout
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- History -->
                <LinearLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_history" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Indicator hình tròn -->
            <View
                android:id="@+id/indicator"
                android:layout_width="0dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_active_toolbar"/>
        </FrameLayout>



        <!-- ChatBot Button: 1/3 -->
        <LinearLayout
            android:id="@+id/buttonSetting"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_pr"
                android:elevation="1dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_setting" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Nút ChatBot -->
    <LinearLayout
        android:id="@+id/chatButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_button_circle"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="56dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_box" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ChatBot"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- FrameLayout ChatBot (ban đầu ẩn) -->
    <FrameLayout
        android:id="@+id/containerChatBot"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_button_cricle_blr"
        android:visibility="gone">

        <!-- Nội dung ChatBot -->
        <LinearLayout
            android:id="@+id/chatContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"> {/* Giữ visibility="gone" ở đây, sẽ được quản lý bằng code Java */}

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/messageEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Nhập tin nhắn..."
                    android:inputType="textShortMessage"
                    android:maxLines="1"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gửi"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.example.green.Setting
        android:id="@+id/settingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="visible" />
    </FrameLayout>



</RelativeLayout>
