<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Bottom Navigation -->

    <FrameLayout
        android:id="@+id/containerLayout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

    </FrameLayout>



    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <!-- Custom Toolbar: 2/3 -->
        <FrameLayout
            android:id="@+id/customToolbarWrapper"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="2"
            android:layout_marginLeft="18dp">

            <!-- Custom Toolbar -->
            <LinearLayout
                android:id="@+id/customToolbar"
                android:layout_width="match_parent"
                android:translationZ="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bottom_toolbar"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <!-- Home -->
                <LinearLayout
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- History -->
                <LinearLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_history" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Indicator hình tròn -->
            <View
                android:id="@+id/indicator"
                android:layout_width="0dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_active_toolbar"/>
        </FrameLayout>



        <!-- ChatBot Button: 1/3 -->
        <LinearLayout
            android:id="@+id/buttonChatBot"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="horizontal">


<!--            &lt;!&ndash; this is button &ndash;&gt;-->
<!--            <LinearLayout-->
<!--                android:layout_width="70dp"-->
<!--                android:layout_height="70dp"-->
<!--                android:background="@drawable/bg_button_circle"-->
<!--                android:elevation="1dp"-->
<!--                android:gravity="center"-->
<!--                android:orientation="vertical"-->
<!--                android:padding="6dp">-->

<!--                <ImageView-->
<!--                    android:layout_width="24dp"-->
<!--                    android:layout_height="24dp"-->
<!--                    android:src="@drawable/ic_box" />-->

<!--                <TextView-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="ChatBot"-->
<!--                    android:textColor="@color/black"-->
<!--                    android:textSize="12sp" />-->
<!--            </LinearLayout>-->

        </LinearLayout>
    </LinearLayout>

    <!-- Nút ChatBot -->
    <LinearLayout
        android:id="@+id/chatButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_button_circle"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="56dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_box" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ChatBot"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- FrameLayout ChatBot (ban đầu ẩn) -->
    <FrameLayout
        android:id="@+id/containerChatBot"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_button_cricle_blr"
        android:visibility="gone">

        <!-- Nội dung ChatBot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:id="@+id/chatContent">

            <!-- Ví dụ: TextView -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello! I am your ChatBot"
                android:textColor="@color/black" />

        </LinearLayout>
    </FrameLayout>


</RelativeLayout>
