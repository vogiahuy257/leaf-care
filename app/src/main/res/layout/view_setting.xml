<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:visibility="visible"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header: Title (Không còn nút đóng ở góc trên bên phải) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/settingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cài đặt"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginBottom="16dp"/>

            <!-- Model Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn mô hình"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/bgSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:entries="@array/background_options" />
            <!-- Nút đóng tròn không còn ở đây -->
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nút Đóng Mới - Nằm ngoài CardView, ở dưới cùng, chính giữa -->
    <ImageButton
        android:id="@+id/btnCloseSetting"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_circular_green_button"
        app:tint="@android:color/white"
        android:contentDescription="Đóng"
        android:padding="12dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"/>
</FrameLayout>